{
  "name": "@cdzzy/agent-kernel",
  "version": "0.10.1",
  "description": "Multi-Agent traffic control layer - resource scheduling, priority arbitration, deadlock detection, and concurrency primitives for AI agent systems",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-kernel": "./dist/cli-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "agent",
    "multi-agent",
    "scheduler",
    "deadlock",
    "concurrency",
    "resource-management",
    "priority",
    "orchestration",
    "llm",
    "agent-os"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "js-yaml": "^5.4.2",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "vitepress": {
      "esbuild": "^0.25.0",
      "vite": "^6.4.3"
    }
  }
}
